# Copy this file to tools/phase-10c-runtime.env. That local file is gitignored.
# Do not put passwords, API/application keys, OAuth secrets, cookies, or tokens here.

# Required for all preflight runs. Mutations require `development` or `test`.
WORDPRESS_TEST_TARGET=development
WORDPRESS_TEST_URL=https://development.example.test
WORDPRESS_TEST_USER=runtime-test-user
WORDPRESS_TEST_ACCOUNT=runtime-test-owner

# Optional safe, dedicated fixture paths. They must not include query credentials.
# WORDPRESS_TEST_PERSONAL_GATEWAY_PATH=/gateway/test-owner/test-personal-api
# WORDPRESS_TEST_ORGANIZATION_GATEWAY_PATH=/gateway/freedomapi-runtime-test/test-organization-api
# WORDPRESS_TEST_PORTAL_PATH=/developers

# Optional WP-CLI over SSH metadata for manual certification steps. Authentication
# must use an existing secure SSH agent/keychain mechanism, never this file.
# WORDPRESS_TEST_SSH_HOST=ssh.example.test
# WORDPRESS_TEST_SSH_USER=wp-test
# WORDPRESS_TEST_SSH_PORT=22
# WORDPRESS_TEST_WP_PATH=/home/account/public_html

# Set only in the local environment immediately before an approved mutation run.
# WORDPRESS_TEST_CONFIRM_DEDICATED=YES